class UsageError(RuntimeError):
    pass


def default_home(variable: str, xdg_variable: str, fallback: Path) -> Path:
    if os.environ.get(variable):
        return Path(os.environ[variable]).expanduser()
    if os.environ.get(xdg_variable):
        return Path(os.environ[xdg_variable]).expanduser() / "cloudmake"
    return fallback.expanduser()


def homes() -> tuple[Path, Path, Path]:
    home = Path.home()
    return (
        default_home("CLOUDMAKE_CONFIG_HOME", "XDG_CONFIG_HOME", home / ".config/cloudmake"),
        default_home(
            "CLOUDMAKE_STATE_HOME", "XDG_STATE_HOME", home / ".local/state/cloudmake"
        ),
        default_home("CLOUDMAKE_CACHE_HOME", "XDG_CACHE_HOME", home / ".cache/cloudmake"),
    )


def project_key(project: Path) -> str:
    material = f"{socket.gethostname()}\0{project}".encode(
        "utf-8", errors="surrogateescape"
    )
    return hashlib.sha256(material).hexdigest()[:24]


def project_slug(project: Path, key: str) -> str:
    stem = re.sub(r"[^A-Za-z0-9._-]+", "-", project.name).strip("-.")
    return f"{stem or 'project'}-{key[:8]}"


def colab_session_name(
    project: Path, key: str, state_root: Path, config_home: Path
) -> str:
    if "COLAB_SESSION" in os.environ:
        return os.environ["COLAB_SESSION"]
    configured = load_json(config_home / "projects" / f"{key}.json").get(
        "colab_session"
    )
    if configured is not None:
        if not isinstance(configured, str) or not COLAB_SESSION_NAME.fullmatch(
            configured
        ):
            raise UsageError("configured Colab session name is invalid")
        return configured
    if (state_root / "colab-notebook" / "cuda-build").is_dir():
        print(
            "[colab] Continuing with legacy session cuda-build for this project's "
            "existing v0.9 state. To select and persist a replacement: "
            "COLAB_SESSION=NAME cloudmake --use colab"
        )
        return "cuda-build"
    return project_slug(project, key)


def load_json(path: Path, *, optional: bool = True) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        if optional:
            return {}
        raise
    except Exception as error:
        raise UsageError(f"cloudmake configuration is corrupt: {path}: {error}") from error
    if not isinstance(value, dict):
        raise UsageError(f"cloudmake configuration must be a JSON object: {path}")
    return value


def atomic_json(path: Path, value: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.", suffix=".tmp", dir=path.parent
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(value, stream, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def utc_timestamp() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def assignment_receipts(arguments: list[str]) -> list[dict[str, str]]:
    receipts = []
    for argument in arguments:
        name, value = argument.split("=", 1)
        receipts.append(
            {
                "name": name,
                "value_sha256": hashlib.sha256(value.encode("utf-8")).hexdigest(),
            }
        )
    return receipts


def source_manifest_snapshot(state_root: Path, backend: str) -> dict[Path, int]:
    directory = state_root / "manifests" / backend
    return {
        path: path.stat().st_mtime_ns
        for path in directory.glob("*.json")
        if path.is_file()
    }


def newest_source_manifest(
    state_root: Path, backend: str, previous: dict[Path, int]
) -> tuple[str | None, dict[str, Any] | None]:
    directory = state_root / "manifests" / backend
    candidates = sorted(
        (
            path
            for path in directory.glob("*.json")
            if path.is_file() and previous.get(path) != path.stat().st_mtime_ns
        ),
        key=lambda path: path.stat().st_mtime_ns,
        reverse=True,
    )
    if not candidates:
        return None, None
    path = candidates[0]
    try:
        manifest = load_json(path, optional=False)
    except Exception:
        return path.stem, None
    return path.stem, {
        "fingerprint": manifest.get("fingerprint"),
        "total_bytes": manifest.get("total_bytes"),
        "entries": len(manifest.get("entries", {})),
    }


def artifact_receipt(directory: Path) -> dict[str, Any] | None:
    if not directory.is_dir():
        return None
    digest = hashlib.sha256()
    total_bytes = 0
    files = 0
    for path in sorted(directory.rglob("*"), key=lambda item: item.as_posix()):
        if not path.is_file():
            continue
        relative = path.relative_to(directory).as_posix().encode("utf-8")
        add = len(relative).to_bytes(8, "big") + relative
        digest.update(add)
        files += 1
        total_bytes += path.stat().st_size
        with path.open("rb") as stream:
            for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                digest.update(chunk)
    return {
        "path": os.fspath(directory),
        "fingerprint": digest.hexdigest(),
        "files": files,
        "total_bytes": total_bytes,
    }


def oci_receipt_snapshot(state_root: Path) -> dict[Path, int]:
    return {
        path: path.stat().st_mtime_ns
        for pattern in (
            "target-result.json", "oci-result.json", "oci-preflight.json",
            "cloudmake-oci-result.json",
        )
        for path in state_root.rglob(pattern)
        if path.is_file()
    }


def newest_oci_receipt(
    state_root: Path, previous: dict[Path, int]
) -> dict[str, Any]:
    candidates = sorted(
        (
            path
            for pattern in (
                "target-result.json", "oci-result.json", "oci-preflight.json",
                "cloudmake-oci-result.json",
            )
            for path in state_root.rglob(pattern)
            if path.is_file() and previous.get(path) != path.stat().st_mtime_ns
        ),
        key=lambda path: path.stat().st_mtime_ns,
        reverse=True,
    )
    for path in candidates:
        try:
            receipt = load_json(path, optional=False)
        except Exception:
            continue
        if receipt.get("runner") == "oci":
            return receipt
    return {}


def allocation_receipt(path: Path) -> dict[str, Any] | None:
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return None
    except Exception:
        return {"attempts": 0, "outcome": "receipt-invalid"}
    if not isinstance(payload, dict) or payload.get("schema") != 1:
        return {"attempts": 0, "outcome": "receipt-invalid"}
    attempts = payload.get("attempts")
    outcome = payload.get("outcome")
    if (
        isinstance(attempts, bool)
        or not isinstance(attempts, int)
        or attempts < 0
        or not isinstance(outcome, str)
        or not outcome
    ):
        return {"attempts": 0, "outcome": "receipt-invalid"}
    receipt: dict[str, Any] = {"attempts": attempts, "outcome": outcome}
    classification = payload.get("classification")
    if isinstance(classification, str) and classification:
        receipt["classification"] = classification
    return receipt


def checkpoint_receipts(state_root: Path, run_id: str) -> list[dict[str, Any]]:
    receipts: list[dict[str, Any]] = []
    paths = [
        *state_root.glob(f"colab-notebook/*/checkpoint/{run_id}-*.json"),
        *state_root.glob(f"kaggle-notebook/*/checkpoint/{run_id}-*.json"),
    ]
    for path in sorted(paths):
        try:
            payload = load_json(path, optional=False)
        except Exception:
            receipts.append({"status": "receipt-invalid"})
            continue
        receipt = {
            name: payload[name]
            for name in (
                "operation",
                "status",
                "outcome",
                "reason",
                "repository",
                "snapshot",
                "data_added",
                "profile",
                "current_profile",
                "files",
                "bytes",
                "sha256",
                "restore",
                "runtime",
                "error",
            )
            if name in payload
        }
        receipts.append(receipt)
    operation_order = {"restore": 0, "publish": 1, "purge": 2}
    receipts.sort(key=lambda receipt: operation_order.get(receipt.get("operation"), 99))
    return receipts


def allocation_exit_code(receipt: dict[str, Any] | None, default: int) -> int:
    if receipt is None:
        return default
    if receipt.get("outcome") == "capacity-timeout":
        return EX_TEMPFAIL
    if receipt.get("outcome") == "interrupted":
        return 130
    return default


def canonical_backend(value: str) -> str:
    try:
        return ALIASES[value]
    except KeyError as error:
        choices = ", ".join(sorted(ALIASES))
        raise UsageError(f"unknown backend {value!r}; choose one of: {choices}") from error


def take_value(arguments: list[str], index: int, option: str) -> tuple[str, int]:
    if index + 1 >= len(arguments):
        raise UsageError(f"{option} requires a value")
    return arguments[index + 1], index + 2


def set_action(options: dict[str, Any], action: str) -> None:
    current = options["action"]
    if current is not None and current != action:
        raise UsageError(f"cloud operation --{current} cannot be combined with --{action}")
    options["action"] = action


def parse_invocation(arguments: list[str]) -> tuple[dict[str, Any], list[str]]:
    options: dict[str, Any] = {
        "action": None,
        "backend": None,
        "project": Path.cwd(),
        "jobs": None,
        "retry_for": None,
        "accelerator": None,
        "accelerator_set": False,
        "checkpoint": None,
        "image": None,
        "native_runner": False,
        "devices": [],
        "devices_set": False,
        "force": False,
        "host": None,
        "host_template": None,
        "global": False,
        "use_backend": None,
        "verbose": False,
        "workspace_action": None,
    }
    index = 0
    while index < len(arguments):
        argument = arguments[index]
        if argument == "--":
            index += 1
            break
        if argument in ("-b", "--backend"):
            options["backend"], index = take_value(arguments, index, argument)
        elif argument.startswith("--backend="):
            options["backend"] = argument.split("=", 1)[1]
            index += 1
        elif argument == "-C":
            value, index = take_value(arguments, index, argument)
            options["project"] = Path(value)
        elif argument == "-j":
            options["jobs"], index = take_value(arguments, index, argument)
        elif argument.startswith("-j") and len(argument) > 2:
            options["jobs"] = argument[2:]
            index += 1
        elif argument == "--host":
            options["host"], index = take_value(arguments, index, argument)
        elif argument.startswith("--host="):
            options["host"] = argument.split("=", 1)[1]
            index += 1
        elif argument == "--host-template":
            set_action(options, "host-template")
            options["host_template"], index = take_value(arguments, index, argument)
        elif argument.startswith("--host-template="):
            set_action(options, "host-template")
            options["host_template"] = argument.split("=", 1)[1]
            index += 1
        elif argument == "--gpu":
            options["accelerator_set"] = True
            options["accelerator"] = "T4"
            index += 1
        elif argument.startswith("--gpu="):
            options["accelerator"] = argument.split("=", 1)[1] or "T4"
            options["accelerator_set"] = True
            index += 1
        elif argument == "--cpu":
            options["accelerator"] = ""
            options["accelerator_set"] = True
            index += 1
        elif argument == "--checkpoint":
            options["checkpoint"] = True
            index += 1
        elif argument == "--no-checkpoint":
            options["checkpoint"] = False
            index += 1
        elif argument == "--persist":
            options["checkpoint"] = True
            index += 1
        elif argument == "--no-persist":
            options["checkpoint"] = False
            index += 1
        elif argument == "--image":
            options["image"], index = take_value(arguments, index, argument)
        elif argument.startswith("--image="):
            options["image"] = argument.split("=", 1)[1]
            index += 1
        elif argument == "--native":
            options["native_runner"] = True
            index += 1
        elif argument == "--device":
            value, index = take_value(arguments, index, argument)
            options["devices"].append(value)
            options["devices_set"] = True
        elif argument.startswith("--device="):
            options["devices"].append(argument.split("=", 1)[1])
            options["devices_set"] = True
            index += 1
        elif argument == "--no-devices":
            options["devices"] = []
            options["devices_set"] = True
            index += 1
        elif argument == "--workspace":
            set_action(options, "workspace")
            options["workspace_action"], index = take_value(arguments, index, argument)
        elif argument == "--force":
            options["force"] = True
            index += 1
        elif argument == "--retry-for":
            options["retry_for"], index = take_value(arguments, index, argument)
        elif argument.startswith("--retry-for="):
            options["retry_for"] = argument.split("=", 1)[1]
            index += 1
        elif argument == "--verbose":
            options["verbose"] = True
            index += 1
        elif argument == "--global":
            options["global"] = True
            index += 1
        elif argument == "--use":
            set_action(options, "use")
            value, index = take_value(arguments, index, argument)
            options["use_backend"] = canonical_backend(value)
        elif argument in ACTION_OPTIONS:
            set_action(options, ACTION_OPTIONS[argument])
            index += 1
        elif argument.startswith("-"):
            raise UsageError(f"unknown cloudmake option: {argument}")
        else:
            break
    return options, arguments[index:]


def help_text(project: Path, backend: str, ssh_host: str | None) -> str:
    host_line = (
        f"\nSSH host: {ssh_host or 'not configured'}"
        if backend == "host-ssh"
        else ""
    )
    return f"""cloudmake {VERSION}
Project: {project}
Backend: {backend}{host_line}

Usage: cloudmake [options] TARGET [NAME=value ...]

Every positional name is passed unchanged to the project Makefile. Cloudmake
reserves no project target names.

Project options: -b BACKEND, -C DIR, -j N, --host HOST, --gpu[=TYPE], --cpu,
                 --persist, --no-persist, --image REF@sha256:DIGEST,
                 --device CDI_NAME, --no-devices, --native,
                 --retry-for=DURATION, --verbose
Cloud operations: --use BACKEND, --doctor, --backends, --start, --sync,
                  --sync-dry-run, --status, --environment, --fetch, --open,
                  --shell, --stop
Managed checkpoint workspaces: --workspaces; --workspace {{show,attach,purge}} [ID]
                               (purge requires --force)
Persistence selection: --persist/--no-persist are local and per project;
                       --checkpoint/--no-checkpoint remain compatible aliases.
Persistence modes: Colab notebook=encrypted checkpoint; Kaggle=private-output
                   checkpoint; local/persistent SSH=native storage (no transfer);
                   Colab SSH=unsupported.
Artifacts: --collect DIR TARGET runs that target and fetches project-relative DIR.
Capacity retry: cloudmake --retry-for=30m --start (classified allocation only).
Environment: --environment records observed VM facts, not format compatibility.
Runner: --image selects OCI/CDI Make; --native restores native Make. Selection
        is local and per project unless -b is an explicit one-off override.
Information: --help, --version, --history, --host-templates,
             --host-template NAME
"""


def backend_declaration(backend: str, name: str) -> str:
    path = TOOL_ROOT / "backends" / f"{backend}.mk"
    try:
        source = path.read_text(encoding="utf-8")
    except OSError as error:
        raise UsageError(f"cannot read backend definition {path}: {error}") from error
    match = re.search(
        rf"^{re.escape(name)}\s*:?=\s*([^#\n]*?)\s*$", source, re.MULTILINE
    )
    if match is None:
        raise UsageError(f"backend {backend!r} does not declare {name}")
    return match.group(1).strip()


def backend_oci_runtimes(backend: str) -> list[str]:
    values = backend_declaration(backend, "BACKEND_OCI_RUNTIMES").split()
    if values == ["none"]:
        return []
    if not values or len(values) != len(set(values)):
        raise UsageError(f"backend {backend!r} has invalid OCI runtime options")
    invalid = [value for value in values if value not in OCI_RUNTIME_CANDIDATES]
    if invalid:
        raise UsageError(
            f"backend {backend!r} has unknown OCI runtime option(s): "
            + ", ".join(invalid)
        )
    return values


def show_backends() -> None:
    print(
        f"{'BACKEND':22} {'SESSION REUSE':13} {'PERSISTENCE':12} "
        f"{'TRANSPORT':36} {'OCI RUNTIMES':34} {'INTERNET IN':12} "
        f"{'INTERNET OUT':12} HOST CLIENT"
    )
    for name, (session_reuse, transport, client) in BACKENDS.items():
        installed = "found" if shutil.which(client) else "missing"
        runtimes = backend_oci_runtimes(name)
        runtime_text = ",".join(runtimes) if runtimes else "unsupported"
        internet_in = backend_declaration(name, "BACKEND_INTERNET_INBOUND")
        internet_out = backend_declaration(name, "BACKEND_INTERNET_OUTBOUND")
        print(
            f"{name:22} {session_reuse:13} {PERSISTENCE_MODES[name]:12} "
            f"{transport:36} {runtime_text:34} {internet_in:12} "
            f"{internet_out:12} {client} ({installed})"
        )


def validate_persistence(backend: str, enabled: bool) -> str:
    mode = PERSISTENCE_MODES[backend]
    if enabled and mode == "unsupported":
        reason = (
            "the SSH-managed Colab VM is ephemeral and this transport has no "
            "cross-VM checkpoint store"
        )
        raise UsageError(
            f"backend {backend!r} does not support persistent workspaces: {reason}; "
            "select it with --no-persist"
        )
    return mode


def persistence_selection_note(enabled: bool, mode: str) -> str:
    if not enabled:
        return "persistent-workspace=disabled"
    if mode == "native":
        return (
            "persistent-workspace=enabled mode=native "
            "(backend storage; no checkpoint transfer)"
        )
    return "persistent-workspace=enabled mode=checkpoint"


def host_templates() -> dict[str, Path]:
    return {
        path.stem: path
        for path in sorted(HOST_TEMPLATE_DIR.glob("*.conf"))
        if path.is_file()
    }


def show_host_templates() -> None:
    templates = host_templates()
    if not templates:
        raise UsageError("installed SSH host templates were not found")
    print("Available SSH host templates:")
    for name in templates:
        print(f"  {name}")
    print("Render one with: cloudmake --host-template NAME")
    print("Cloudmake prints templates but never modifies ~/.ssh or creates keys.")
    guide = HOST_TEMPLATE_DIR / "README.md"
    if guide.is_file():
        print(f"Installed guide: {guide}")


def show_host_template(name: str) -> None:
    if not HOST_TEMPLATE_NAME.fullmatch(name):
        raise UsageError("invalid SSH host template name")
    try:
        path = host_templates()[name]
    except KeyError as error:
        choices = ", ".join(host_templates())
        raise UsageError(
            f"unknown SSH host template {name!r}; choose one of: {choices}"
        ) from error
    sys.stdout.write(path.read_text(encoding="utf-8"))


def show_history(state_home: Path, key: str) -> None:
    runs = state_home / "projects" / key / "runs"
    paths = sorted(
        (path for path in runs.glob("*.json") if path.name != "latest.json"),
        reverse=True,
    )[:10]
    if not paths:
        print("No cloudmake executions have been recorded for this project.")
        return
    print("STARTED                      STATUS       BACKEND              TARGET")
    for path in paths:
        record = load_json(path, optional=False)
        print(
            f"{str(record.get('started_at', '-')):28} "
            f"{str(record.get('status', 'unknown')):12} "
            f"{str(record.get('backend', '-')):20} "
            f"{record.get('target', '-')}"
        )
    print(f"Provenance directory: {runs}")


def workspace_record_path(state_home: Path, workspace_id: str) -> Path:
    if not WORKSPACE_ID.fullmatch(workspace_id):
        raise UsageError("persistent workspace IDs are 24 lowercase hexadecimal characters")
    return state_home / "workspaces" / f"{workspace_id}.json"


def default_workspace_id(project_id: str, backend: str) -> str:
    # Preserve every released Colab workspace identity. Other managed stores
    # get a distinct deterministic namespace so switching providers cannot
    # conflate two unrelated checkpoint repositories.
    if backend == "colab-notebook":
        return project_id
    return hashlib.sha256(f"{project_id}\0{backend}".encode("utf-8")).hexdigest()[:24]


def configured_workspace_id(
    project_config: dict[str, Any], project_id: str, backend: str
) -> str:
    configured = project_config.get("workspace_ids", {})
    if not isinstance(configured, dict) or not all(
        isinstance(name, str)
        and isinstance(value, str)
        and WORKSPACE_ID.fullmatch(value)
        for name, value in configured.items()
    ):
        raise UsageError("configured persistent workspace map is invalid")
    selected = configured.get(backend)
    if selected is not None:
        return selected
    legacy = project_config.get("workspace_id")
    configured_backend = project_config.get("backend")
    if legacy is not None and configured_backend == backend:
        if not isinstance(legacy, str) or WORKSPACE_ID.fullmatch(legacy) is None:
            raise UsageError("configured persistent workspace ID is invalid")
        return legacy
    return default_workspace_id(project_id, backend)


def remember_workspace_id(
    saved: dict[str, Any], backend: str, workspace_id: str
) -> None:
    configured = saved.get("workspace_ids", {})
    if not isinstance(configured, dict):
        configured = {}
    configured = dict(configured)
    configured[backend] = workspace_id
    saved["workspace_ids"] = configured
    saved["workspace_id"] = workspace_id


def load_workspace_record(state_home: Path, workspace_id: str) -> dict[str, Any]:
    path = workspace_record_path(state_home, workspace_id)
    record = load_json(path)
    if not record:
        raise UsageError(f"persistent workspace is not known locally: {workspace_id}")
    if record.get("schema") != 1 or record.get("workspace_id") != workspace_id:
        raise UsageError(f"persistent workspace metadata is corrupt: {path}")
    return record


def update_workspace_record(
    *,
    state_home: Path,
    workspace_id: str,
    project: Path,
    backend: str,
    accelerator: str | None,
    session: str | None = None,
    receipts: list[dict[str, Any]] | None = None,
) -> dict[str, Any]:
    path = workspace_record_path(state_home, workspace_id)
    record = load_json(path)
    now = utc_timestamp()
    if not record:
        record = {
            "schema": 1,
            "workspace_id": workspace_id,
            "created_at": now,
        }
    record.update(
        backend=backend,
        accelerator=accelerator or "cpu",
        project_name=project.name,
        last_attached_project=os.fspath(project),
        last_used_at=now,
    )
    if backend == "colab-notebook" and session is not None:
        record["session"] = session
    for receipt in receipts or []:
        if receipt.get("status") != "succeeded":
            continue
        record["last_operation"] = receipt.get("operation")
        if receipt.get("snapshot"):
            record["latest_snapshot"] = receipt["snapshot"]
        if isinstance(receipt.get("files"), int):
            record["files"] = receipt["files"]
        if isinstance(receipt.get("bytes"), int):
            record["logical_bytes"] = receipt["bytes"]
        if isinstance(receipt.get("runtime"), dict):
            record["last_runtime"] = receipt["runtime"]
    atomic_json(path, record)
    return record


def show_workspaces(state_home: Path) -> None:
    directory = state_home / "workspaces"
    records: list[dict[str, Any]] = []
    for path in sorted(directory.glob("*.json")):
        try:
            record = load_json(path, optional=False)
        except Exception:
            continue
        if record.get("schema") == 1 and WORKSPACE_ID.fullmatch(
            str(record.get("workspace_id", ""))
        ):
            records.append(record)
    if not records:
        print("No managed checkpoint workspaces are known on this computer.")
        return
    print(
        "WORKSPACE_ID              BACKEND             ACCELERATOR  "
        "PROJECT              UPDATED"
    )
    for record in sorted(
        records,
        key=lambda item: str(item.get("last_used_at", "")),
        reverse=True,
    ):
        print(
            f"{record['workspace_id']:24} "
            f"{str(record.get('backend', '-')):19} "
            f"{str(record.get('accelerator', '-')):12} "
            f"{str(record.get('project_name', '-')):20} "
            f"{record.get('last_used_at', '-')}"
        )


def show_workspace(state_home: Path, workspace_id: str) -> None:
    record = load_workspace_record(state_home, workspace_id)
    print(json.dumps(record, indent=2, sort_keys=True))


def detach_workspace_mappings(
    config_home: Path, workspace_id: str, *, keep: Path | None = None
) -> None:
    for path in (config_home / "projects").glob("*.json"):
        if keep is not None and path == keep:
            continue
        saved = load_json(path)
        workspace_ids = saved.get("workspace_ids", {})
        mapped = (
            isinstance(workspace_ids, dict)
            and workspace_id in workspace_ids.values()
        )
        active = saved.get("workspace_id") == workspace_id
        if not active and not mapped:
            continue
        if isinstance(workspace_ids, dict):
            remaining = {
                name: value for name, value in workspace_ids.items()
                if value != workspace_id
            }
            if remaining:
                saved["workspace_ids"] = remaining
            else:
                saved.pop("workspace_ids", None)
        if active:
            saved.pop("workspace_id", None)
            saved.pop("checkpoint", None)
            saved["persistent_workspace"] = False
        atomic_json(path, saved)


def manage_workspace(
    *,
    project: Path,
    project_id: str,
    config_home: Path,
    state_home: Path,
    cache_home: Path,
    options: dict[str, Any],
    positional: list[str],
) -> int:
    if (
        options["backend"] is not None
        or options["accelerator_set"]
        or options["checkpoint"] is not None
        or options["image"] is not None
        or options["native_runner"]
        or options["devices_set"]
        or options["host"] is not None
        or options["global"]
    ):
        raise UsageError(
            "workspace management cannot be combined with backend, host, accelerator, "
            "persistence, runner, or global selection options"
        )
    operation = options["workspace_action"]
    if operation not in {"show", "attach", "purge"}:
        raise UsageError("--workspace requires one of: show, attach, purge")
    project_config = load_json(config_home / "projects" / f"{project_id}.json")
    configured_backend = canonical_backend(str(project_config.get("backend", "colab")))
    current = configured_workspace_id(project_config, project_id, configured_backend)
    if operation == "show":
        if options["force"]:
            raise UsageError("--force is not used with --workspace show")
        if len(positional) > 1:
            raise UsageError("--workspace show accepts at most one workspace ID")
        show_workspace(state_home, positional[0] if positional else current)
        return 0
    if len(positional) != 1:
        raise UsageError(f"--workspace {operation} requires one workspace ID")
    selected = positional[0]
    record = load_workspace_record(state_home, selected)
    record_backend = record.get("backend")
    if record_backend not in {"colab-notebook", "kaggle-notebook"}:
        raise UsageError("the selected backend does not provide managed checkpoints")
    if operation == "attach":
        if options["force"]:
            raise UsageError("--force is not used with --workspace attach")
        config_path = config_home / "projects" / f"{project_id}.json"
        detach_workspace_mappings(config_home, selected, keep=config_path)
        saved = project_config
        saved.update(
            backend=record_backend,
            persistent_workspace=True,
            checkpoint=True,
            workspace_id=selected,
            project=os.fspath(project),
        )
        remember_workspace_id(saved, record_backend, selected)
        saved_accelerator = record.get("accelerator")
        if isinstance(saved_accelerator, str):
            saved["accelerator"] = "" if saved_accelerator == "cpu" else saved_accelerator
        atomic_json(config_path, saved)
        update_workspace_record(
            state_home=state_home,
            workspace_id=selected,
            project=project,
            backend=record_backend,
            accelerator=(
                saved_accelerator if isinstance(saved_accelerator, str) else None
            ),
        )
        accelerator_note = (
            f" accelerator={saved_accelerator}"
            if isinstance(saved_accelerator, str) and saved_accelerator
            else " accelerator=cpu"
        )
        print(
            f"[cloudmake] attached project={project.name} to persistent-workspace={selected}; "
            f"backend={record_backend}{accelerator_note}; subsequent targets restore and update it."
        )
        return 0
    if not options["force"]:
        detail = (
            "the encrypted Drive repository and its local key"
            if record_backend == "colab-notebook"
            else "both private Kaggle checkpoint kernel slots"
        )
        raise UsageError(
            f"purging permanently deletes {detail}; rerun with --force "
            "--workspace purge WORKSPACE_ID"
        )
    purge_session = record.get("session")
    if not isinstance(purge_session, str) or not purge_session:
        purge_session = os.environ.get("COLAB_SESSION", "cuda-build")
    exit_code = engine_command(
        project=project,
        backend=record_backend,
        accelerator="",
        accelerator_set=True,
        ssh_host=None,
        jobs=options["jobs"],
        verbose=options["verbose"],
        state_home=state_home,
        cache_home=cache_home,
        key=project_id,
        workspace_id=selected,
        target="workspace-purge",
        assignments=[],
        retry_seconds=None,
        checkpoint=True,
        colab_session=purge_session if record_backend == "colab-notebook" else None,
    )
    if exit_code == 0:
        workspace_record_path(state_home, selected).unlink(missing_ok=True)
        detach_workspace_mappings(config_home, selected)
        print(f"[cloudmake] persistent-workspace={selected} purged and detached")
    return exit_code


def resolve_ssh_host(
    options: dict[str, Any], project_config: dict[str, Any], global_config: dict[str, Any]
) -> str | None:
    value: Any = options["host"]
    if value is None:
        value = os.environ.get("CLOUDMAKE_SSH_HOST") or os.environ.get("SSH_HOST")
    if value is None:
        value = project_config.get("host", global_config.get("host"))
    if value is None:
        return None
    if not isinstance(value, str) or not SSH_HOST_ALIAS.fullmatch(value):
        raise UsageError(
            "SSH host aliases must begin with a letter or number and contain only "
            "letters, numbers, dot, dash, and underscore"
        )
    return value


def resolve_preferences(
    project: Path, options: dict[str, Any], config_home: Path, key: str
) -> tuple[str, str | None, bool, str | None, bool, str]:
    global_config = load_json(config_home / "config.json")
    shared_config = load_json(project / ".cloudmake.json")
    project_config = load_json(config_home / "projects" / f"{key}.json")

    backend_value = (
        options["backend"]
        or os.environ.get("CLOUDMAKE_BACKEND")
        or project_config.get("backend")
        or shared_config.get("backend")
        or global_config.get("backend")
        or "colab-notebook"
    )
    backend = canonical_backend(str(backend_value))
    ssh_host = (
        resolve_ssh_host(options, project_config, global_config)
        if backend == "host-ssh"
        else None
    )

    checkpoint: Any = options["checkpoint"]
    if checkpoint is None:
        if "persistent_workspace" in project_config:
            checkpoint = project_config["persistent_workspace"]
        elif "checkpoint" in project_config:  # early stateful prototype compatibility
            checkpoint = project_config["checkpoint"]
    if checkpoint is None:
        checkpoint = False
    if not isinstance(checkpoint, bool):
        raise UsageError("configured persistent-workspace selection must be true or false")

    workspace_id = configured_workspace_id(project_config, key, backend)

    if options["accelerator_set"]:
        return backend, options["accelerator"], True, ssh_host, checkpoint, workspace_id
    if "CLOUDMAKE_GPU" in os.environ:
        return backend, os.environ["CLOUDMAKE_GPU"], True, ssh_host, checkpoint, workspace_id
    for config in (project_config, shared_config, global_config):
        if "accelerator" in config:
            if backend not in GPU_BACKENDS:
                return backend, None, False, ssh_host, checkpoint, workspace_id
            value = config["accelerator"]
            if not isinstance(value, str):
                raise UsageError("configured accelerator must be a string")
            return backend, value, True, ssh_host, checkpoint, workspace_id
    return backend, None, False, ssh_host, checkpoint, workspace_id


def validate_runner_selection(
    image: Any, devices: Any
) -> tuple[str, str | None, list[str]]:
    if image is None:
        if devices:
            raise UsageError("CDI devices require an OCI image selection")
        return "native", None, []
    if not isinstance(image, str) or OCI_IMAGE.fullmatch(image) is None:
        raise UsageError(
            "--image requires an immutable OCI reference of the form "
            "REGISTRY/IMAGE@sha256:<64 lowercase hex digits>"
        )
    if not isinstance(devices, list) or not all(isinstance(item, str) for item in devices):
        raise UsageError("configured CDI devices must be a string list")
    for device in devices:
        if CDI_DEVICE.fullmatch(device) is None:
            raise UsageError(
                f"invalid CDI device {device!r}; expected vendor.example/class=device"
            )
    if len(set(devices)) != len(devices):
        raise UsageError("duplicate CDI device selections are not allowed")
    return "oci", image, devices


def validate_backend_oci_selection(
    *, backend: str, runner: str, devices: list[str], accelerator: Any
) -> list[str]:
    runtimes = backend_oci_runtimes(backend)
    if runner == "native":
        return runtimes
    if not runtimes:
        raise UsageError(f"backend {backend!r} does not support the managed OCI runner")
    cdi_capable = {"podman", "docker", "nerdctl", "proot", "crun"}
    if devices and not cdi_capable.intersection(runtimes):
        raise UsageError(
            f"backend {backend!r} OCI runtime options cannot apply CDI devices"
        )
    if accelerator and not cdi_capable.intersection(runtimes):
        raise UsageError(
            f"backend {backend!r} OCI runtime options are CPU-only; "
            "select --cpu or --native"
        )
    return runtimes


def resolve_runner_preferences(
    options: dict[str, Any], project: Path, config_home: Path, key: str
) -> tuple[str, str | None, list[str]]:
    if options["native_runner"] and options["image"] is not None:
        raise UsageError("--native cannot be combined with --image")
    if options["native_runner"] and options["devices_set"]:
        raise UsageError("--native cannot be combined with --device or --no-devices")
    project_config = load_json(config_home / "projects" / f"{key}.json")
    shared_config = load_json(project / ".cloudmake.json")
    global_config = load_json(config_home / "config.json")
    if options["native_runner"]:
        return "native", None, []

    configured_image: Any = None
    configured_devices: Any = []
    for config in (project_config, shared_config, global_config):
        if "image" in config:
            configured_image = config["image"]
            configured_devices = config.get("devices", [])
            break
    image = options["image"] if options["image"] is not None else configured_image
    if options["devices_set"]:
        devices = options["devices"]
    elif options["image"] is not None:
        # A new image selection must not silently inherit device requirements
        # from the previously selected image.
        devices = []
    else:
        devices = configured_devices
    return validate_runner_selection(image, devices)


def persist_invocation_runner(
    *,
    project: Path,
    config_home: Path,
    key: str,
    runner: str,
    image: str | None,
    devices: list[str],
) -> None:
    path = config_home / "projects" / f"{key}.json"
    saved = load_json(path)
    if runner == "native":
        saved.pop("image", None)
        saved.pop("devices", None)
    else:
        saved["image"] = image
        saved["devices"] = devices
    saved["project"] = os.fspath(project)
    atomic_json(path, saved)
    detail = "runner=native" if runner == "native" else f"runner=oci image={image}"
    if devices:
        detail += f" devices={','.join(devices)}"
    print(
        f"[cloudmake] selected {detail} for project={project.name}; "
        "subsequent targets reuse this selection.",
        flush=True,
    )


def validate_project(project: Path) -> Path:
    resolved = project.expanduser().resolve()
    if not resolved.is_dir():
        raise UsageError(f"project directory does not exist: {resolved}")
    return resolved


def validate_assignments(arguments: list[str]) -> None:
    for argument in arguments:
        if not ASSIGNMENT.match(argument):
            raise UsageError(
                f"unexpected argument {argument!r}; trailing arguments must be NAME=value"
            )
        name = argument.split("=", 1)[0]
        if name in RESERVED_ASSIGNMENTS:
            raise UsageError(f"{name} is managed by cloudmake and cannot be overridden here")


def encoded_arguments(arguments: list[str]) -> str:
    payload = json.dumps(arguments, ensure_ascii=False, separators=(",", ":")).encode()
    return base64.urlsafe_b64encode(payload).decode("ascii")


def encoded_value(value: str) -> str:
    return base64.urlsafe_b64encode(value.encode("utf-8")).decode("ascii")


def retry_duration(value: str | None) -> int | None:
    if value is None:
        return None
    match = DURATION.fullmatch(value)
    if match is None:
        raise UsageError("--retry-for requires a positive duration such as 30s, 15m, or 2h")
    amount = int(match.group(1))
    multiplier = {"s": 1, "m": 60, "h": 3600}[match.group(2)]
    seconds = amount * multiplier
    if seconds > 24 * 3600:
        raise UsageError("--retry-for must not exceed 24h")
    return seconds


def collect_directory(value: str) -> str:
    path = PurePosixPath(value)
    if (
        not value
        or "\n" in value
        or path.is_absolute()
        or ".." in path.parts
        or (not path.parts and value != ".")
    ):
        raise UsageError("collection directory must be a safe project-relative path")
    return path.as_posix()


def engine_command(
    *,
    project: Path,
    backend: str,
    accelerator: str | None,
    accelerator_set: bool,
    ssh_host: str | None,
    jobs: str | None,
    verbose: bool,
    state_home: Path,
    cache_home: Path,
    key: str,
    workspace_id: str,
    target: str,
    assignments: list[str],
    retry_seconds: int | None,
    allocation_result: Path | None = None,
    remote_target: str | None = None,
    remote_collect_dir: str | None = None,
    run_id: str | None = None,
    checkpoint: bool = False,
    colab_session: str | None = None,
    operation_state: Path | None = None,
    runner: str = "native",
    image: str | None = None,
    devices: list[str] | None = None,
    oci_runtimes: list[str] | None = None,
) -> int:
    make = shutil.which("make")
    if make is None:
        raise UsageError("make was not found on PATH")
    variables = [
        f"CLOUDMAKE_TOOL_ROOT={TOOL_ROOT}",
        f"PROJECT_DIR={project}",
        f"CLOUDMAKE_PROJECT_ROOT={project}",
        f"PROJECT={project.name}",
        f"PROJECT_SLUG={project_slug(project, key)}",
        f"CLOUDMAKE_PROJECT_KEY={key}",
        f"CLOUDMAKE_WORKSPACE_ID={workspace_id}",
        f"CLOUDMAKE_CHECKPOINT={1 if checkpoint else 0}",
        "PROJECT_MAKEFILE=Makefile",
        f"ARTIFACT_DIR={project / 'artifacts'}",
        f"CLOUDMAKE_STATE_ROOT={state_home / 'projects' / key}",
        f"CLOUDMAKE_CACHE_ROOT={cache_home / 'projects' / key}",
        f"CLOUDMAKE_PROJECT_ARGS_B64={encoded_arguments(assignments)}",
        f"CLOUDMAKE_RETRY_FOR_SECONDS={retry_seconds or 0}",
        f"BACKEND={backend}",
        f"PYTHON_BIN={sys.executable}",
        f"CLOUDMAKE_RUNNER={runner}",
    ]
    if runner == "oci":
        if image is None:
            raise UsageError("internal OCI runner selection has no image")
        variables.extend(
            [
                f"CLOUDMAKE_OCI_IMAGE_B64={encoded_value(image)}",
                f"CLOUDMAKE_OCI_DEVICES_B64={encoded_arguments(devices or [])}",
                f"CLOUDMAKE_OCI_RUNTIMES_B64={encoded_arguments(oci_runtimes or [])}",
                "CLOUDMAKE_OCI_RUNTIME=auto",
            ]
        )
    if run_id is not None:
        variables.append(f"CLOUDMAKE_RUN_ID={run_id}")
    if allocation_result is not None:
        variables.append(f"CLOUDMAKE_ALLOCATION_RESULT={allocation_result}")
    if colab_session is not None:
        variables.append(f"COLAB_SESSION={colab_session}")
    if operation_state is not None:
        variables.append(f"CLOUDMAKE_OPERATION_STATE={operation_state}")
    if jobs is not None:
        if not jobs.isdigit() or int(jobs) < 1:
            raise UsageError("-j requires a positive integer")
        variables.append(f"JOBS={jobs}")
    if verbose:
        variables.append("CLOUDMAKE_VERBOSE=1")
    if backend == "host-ssh" and ssh_host is not None:
        variables.append(f"SSH_HOST={ssh_host}")
    if workspace_id != key:
        variables.append("CLOUDMAKE_ADOPT=1")
    if accelerator_set:
        variables.append(
            f"CLOUDMAKE_CONTEXT_ACCELERATOR={accelerator or 'cpu'}"
        )
        variable = {
            "colab-notebook": "COLAB_GPU",
            "colab-ssh": "COLAB_GPU",
            "kaggle-notebook": "KAGGLE_ACCELERATOR",
            "lightning-studio-ssh": "LIGHTNING_MACHINE",
        }.get(backend, "CLOUDMAKE_GPU")
        variables.append(f"{variable}={accelerator or ''}")
    if remote_target is not None:
        variables.append(f"REMOTE_TARGET_B64={encoded_value(remote_target)}")
    if remote_collect_dir is not None:
        variables.append(
            f"REMOTE_COLLECT_DIR_B64={encoded_value(remote_collect_dir)}"
        )
    command = [make, "--no-print-directory", "-f", os.fspath(ENGINE), *variables]
    command.append(target)
    if verbose:
        print("+", " ".join(command), file=sys.stderr)
    return subprocess.run(command, cwd=TOOL_ROOT, check=False).returncode


def print_local_execution_context(accelerator: str | None, accelerator_set: bool) -> None:
    fields = ["backend=local"]
    if accelerator_set:
        fields.append(f"accelerator={accelerator or 'cpu'}")
    fields.append("resource=local")
    print("[cloudmake] " + " ".join(fields), flush=True)


def persist_invocation_accelerator(
    *,
    project: Path,
    config_home: Path,
    key: str,
    accelerator: str | None,
) -> None:
    path = config_home / "projects" / f"{key}.json"
    saved = load_json(path)
    saved["accelerator"] = accelerator or ""
    saved["project"] = os.fspath(project)
    atomic_json(path, saved)
    print(
        f"[cloudmake] selected accelerator={accelerator or 'cpu'} for "
        f"project={project.name}; subsequent targets reuse this selection.",
        flush=True,
    )


def persist_invocation_checkpoint(
    *, project: Path, config_home: Path, key: str, backend: str,
    workspace_id: str, enabled: bool, mode: str
) -> None:
    path = config_home / "projects" / f"{key}.json"
    saved = load_json(path)
    saved["persistent_workspace"] = enabled
    saved["checkpoint"] = enabled
    if enabled and mode == "checkpoint":
        configured = saved.get("workspace_ids", {})
        if not isinstance(configured, dict):
            configured = {}
        configured = dict(configured)
        saved_backend = saved.get("backend")
        legacy = saved.get("workspace_id")
        if (
            isinstance(saved_backend, str)
            and saved_backend in {"colab-notebook", "kaggle-notebook"}
            and isinstance(legacy, str)
            and WORKSPACE_ID.fullmatch(legacy)
        ):
            configured.setdefault(saved_backend, legacy)
        configured[backend] = workspace_id
        saved["workspace_ids"] = configured
        if saved_backend in {None, backend}:
            saved["workspace_id"] = workspace_id
    saved["project"] = os.fspath(project)
    atomic_json(path, saved)
    print(
        f"[cloudmake] {persistence_selection_note(enabled, mode)} for "
        f"project={project.name}; subsequent targets reuse this selection.",
        flush=True,
    )


def local_make_command(
    *,
    project: Path,
    target: str,
    assignments: list[str],
    jobs: str | None,
    verbose: bool,
) -> int:
    """Invoke the project Makefile directly, without the backend engine."""
    make = shutil.which("make")
    if make is None:
        raise UsageError("make was not found on PATH")
    command = [make, "-f", "Makefile"]
    if jobs is not None:
        if not jobs.isdigit() or int(jobs) < 1:
            raise UsageError("-j requires a positive integer")
        command.extend(["-j", jobs])
    command.extend([target, *assignments])
    if verbose:
        print("+", " ".join(command), file=sys.stderr)
    return subprocess.run(command, cwd=project, check=False).returncode


def local_oci_command(
    *,
    project: Path,
    image: str,
    devices: list[str],
    oci_runtimes: list[str],
    target: str,
    assignments: list[str],
    jobs: str | None,
    state_root: Path,
    cache_home: Path,
    run_id: str,
    verbose: bool,
) -> tuple[int, dict[str, Any]]:
    parallel = jobs or "4"
    if not parallel.isdigit() or int(parallel) < 1:
        raise UsageError("-j requires a positive integer")
    result = state_root / "oci" / run_id / "result.json"
    common = [
        sys.executable,
        os.fspath(TOOL_ROOT / "tools" / "oci_runner.py"),
        "--image",
        image,
        "--runtime",
        "auto",
        "--source",
        os.fspath(project),
        "--cache",
        os.fspath(cache_home / "oci"),
        "--makefile",
        "Makefile",
    ]
    for runtime in oci_runtimes:
        common.extend(["--runtime-candidate", runtime])
    for device in devices:
        common.extend(["--device", device])
    print(
        f"[cloudmake] backend=local runner=oci image={image} resource=local",
        flush=True,
    )
    command = [
        *common,
        "--mode",
        "run",
        "--target-b64",
        encoded_value(target),
        "--arguments-b64",
        encoded_arguments(assignments),
        "--jobs",
        parallel,
        "--result",
        os.fspath(result),
    ]
    if verbose:
        print("+", " ".join(command), file=sys.stderr)
    exit_code = subprocess.run(command, cwd=project, check=False).returncode
    return exit_code, load_json(result)


def collect_local_artifacts(
    *,
    project: Path,
    directory: str,
    state_root: Path,
    run_id: str,
    verbose: bool,
) -> int:
    """Materialize a local project directory through the normal safe extractor."""
    source = project / directory
    if source.is_symlink() or not source.is_dir():
        print(
            f"cloudmake: collection directory was not produced as a directory: {source}",
            file=sys.stderr,
        )
        return 2

    archive_directory = state_root / "local" / "collections"
    archive_directory.mkdir(parents=True, exist_ok=True)
    archive = archive_directory / f"{run_id}.tar.gz"
    temporary = archive_directory / f".{run_id}.tar.gz.tmp"
    try:
        with tarfile.open(temporary, "w:gz", dereference=False) as bundle:
            bundle.add(source, arcname=".")
        os.replace(temporary, archive)
    finally:
        temporary.unlink(missing_ok=True)

    command = [
        sys.executable,
        os.fspath(TOOL_ROOT / "tools" / "safe_extract.py"),
        "--archive",
        os.fspath(archive),
        "--destination",
        os.fspath(project / "artifacts"),
    ]
    limits = {
        "ARTIFACT_MAX_FILES": "--max-files",
        "ARTIFACT_MAX_MB": "--max-total-mb",
        "ARTIFACT_MAX_FILE_MB": "--max-file-mb",
        "ARTIFACT_MAX_ARCHIVE_MB": "--max-archive-mb",
        "ARTIFACT_MAX_RATIO": "--max-ratio",
    }
    for variable, option in limits.items():
        if variable in os.environ:
            command.extend([option, os.environ[variable]])
    if verbose:
        print("+", " ".join(command), file=sys.stderr)
    return subprocess.run(command, cwd=project, check=False).returncode


def run(arguments: list[str]) -> int:
    options, positional = parse_invocation(arguments)
    retry_seconds = retry_duration(options["retry_for"])
    project = validate_project(options["project"])
    config_home, state_home, cache_home = homes()
    key = project_key(project)
    action = options["action"]

    if options["force"] and action != "workspace":
        raise UsageError("--force is valid only with --workspace purge")

    if retry_seconds is not None and action not in {None, "collect", "start"}:
        raise UsageError("--retry-for is valid only with --start, a project target, or --collect")

    if action == "version":
        if positional:
            raise UsageError("--version does not accept arguments")
        print(f"cloudmake {VERSION}")
        return 0
    if action == "backends":
        if positional:
            raise UsageError("--backends does not accept arguments")
        show_backends()
        return 0
    if action == "history":
        if positional:
            raise UsageError("--history does not accept arguments")
        show_history(state_home, key)
        return 0
    if action == "workspaces":
        if positional:
            raise UsageError("--workspaces does not accept arguments")
        show_workspaces(state_home)
        return 0
    if action == "workspace":
        return manage_workspace(
            project=project,
            project_id=key,
            config_home=config_home,
            state_home=state_home,
            cache_home=cache_home,
            options=options,
            positional=positional,
        )
    if action == "host-templates":
        if positional:
            raise UsageError("--host-templates does not accept arguments")
        show_host_templates()
        return 0
    if action == "host-template":
        if positional:
            raise UsageError("--host-template accepts its name as an option value only")
        show_host_template(options["host_template"])
        return 0
    if action == "use":
        if positional:
            raise UsageError("--use accepts its backend as an option value only")
        if options["backend"] is not None:
            raise UsageError("-b/--backend cannot be combined with --use")
        if options["global"] and options["checkpoint"] is not None:
            raise UsageError(
                "persistent workspaces must be enabled or disabled per project, "
                "not with --global"
            )
        if options["global"] and (
            options["image"] is not None
            or options["native_runner"]
            or options["devices_set"]
        ):
            raise UsageError("OCI runner selection is per project, not global")
        backend = options["use_backend"]
        accelerator_set = options["accelerator_set"]
        accelerator = options["accelerator"]
        if accelerator_set and not ACCELERATOR.fullmatch(accelerator or ""):
            raise UsageError("invalid accelerator name")
        if accelerator and backend not in GPU_BACKENDS:
            raise UsageError(f"backend {backend!r} does not support accelerator requests")
        if options["host"] is not None and backend != "host-ssh":
            raise UsageError("--host is valid only with the ssh backend")
        path = (
            config_home / "config.json"
            if options["global"]
            else config_home / "projects" / f"{key}.json"
        )
        saved = load_json(path)
        global_config = load_json(config_home / "config.json")
        project_config = saved if not options["global"] else {}
        configured_persistence: Any = saved.get(
            "persistent_workspace", saved.get("checkpoint", False)
        )
        if not isinstance(configured_persistence, bool):
            raise UsageError(
                "configured persistent-workspace selection must be true or false"
            )
        selected_persistence = (
            options["checkpoint"]
            if options["checkpoint"] is not None
            else configured_persistence
        )
        persistence_mode = validate_persistence(backend, selected_persistence)
        previous_backend = saved.get("backend")
        legacy_workspace_id = saved.get("workspace_id")
        if (
            isinstance(previous_backend, str)
            and previous_backend in {"colab-notebook", "kaggle-notebook"}
            and isinstance(legacy_workspace_id, str)
            and WORKSPACE_ID.fullmatch(legacy_workspace_id)
        ):
            workspace_ids = saved.get("workspace_ids", {})
            if isinstance(workspace_ids, dict):
                workspace_ids = dict(workspace_ids)
                workspace_ids.setdefault(previous_backend, legacy_workspace_id)
                saved["workspace_ids"] = workspace_ids
        selected_workspace_id = configured_workspace_id(saved, key, backend)
        ssh_host = (
            resolve_ssh_host(options, project_config, global_config)
            if backend == "host-ssh"
            else None
        )
        if backend == "host-ssh" and ssh_host is None:
            raise UsageError("the ssh backend requires --host HOST")
        selected_colab_session = None
        if backend == "colab-notebook" and "COLAB_SESSION" in os.environ:
            selected_colab_session = os.environ["COLAB_SESSION"]
            if not COLAB_SESSION_NAME.fullmatch(selected_colab_session):
                raise UsageError(
                    "Colab session names must contain only letters, numbers, dot, "
                    "dash, and underscore"
                )
            if options["global"]:
                raise UsageError(
                    "COLAB_SESSION can be persisted only with per-project --use"
                )
        saved["backend"] = backend
        if accelerator_set:
            saved["accelerator"] = accelerator or ""
        if backend == "host-ssh":
            saved["host"] = ssh_host
        if selected_colab_session is not None:
            saved["colab_session"] = selected_colab_session
        if options["checkpoint"] is not None:
            saved["persistent_workspace"] = options["checkpoint"]
            saved["checkpoint"] = options["checkpoint"]
        if (
            selected_persistence
            and persistence_mode == "checkpoint"
            and not options["global"]
        ):
            remember_workspace_id(saved, backend, selected_workspace_id)
        elif previous_backend != backend:
            saved.pop("workspace_id", None)
        runner, image, devices = resolve_runner_preferences(
            options, project, config_home, key
        )
        effective_accelerator = (
            accelerator
            if accelerator_set
            else saved.get("accelerator", global_config.get("accelerator", ""))
        )
        validate_backend_oci_selection(
            backend=backend,
            runner=runner,
            devices=devices,
            accelerator=effective_accelerator,
        )
        if runner == "native":
            saved.pop("image", None)
            saved.pop("devices", None)
        else:
            saved["image"] = image
            saved["devices"] = devices
        if not options["global"]:
            saved["project"] = os.fspath(project)
        atomic_json(path, saved)
        scope = "global" if options["global"] else project.name
        accelerator_note = (
            f", accelerator={accelerator or 'cpu'}" if accelerator_set else ""
        )
        host_note = f", host={ssh_host}" if backend == "host-ssh" else ""
        session_note = (
            f", session={selected_colab_session}"
            if selected_colab_session is not None
            else ""
        )
        checkpoint_note = (
            f", {persistence_selection_note(selected_persistence, persistence_mode)}"
            if options["checkpoint"] is not None or selected_persistence
            else ""
        )
        runner_note = (
            ", runner=native"
            if runner == "native"
            else f", runner=oci, image={image}"
        )
        device_note = f", devices={','.join(devices)}" if devices else ""
        print(
            f"Saved {scope} backend={backend}{host_note}{accelerator_note}"
            f"{session_note}{checkpoint_note}{runner_note}{device_note}; "
            "subsequent targets reuse this selection."
        )
        if (
            selected_persistence
            and persistence_mode == "checkpoint"
            and not options["global"]
        ):
            record_accelerator = saved.get(
                "accelerator", global_config.get("accelerator", "")
            )
            state_root = state_home / "projects" / key
            update_workspace_record(
                state_home=state_home,
                workspace_id=selected_workspace_id,
                project=project,
                backend=backend,
                accelerator=(
                    str(record_accelerator) if isinstance(record_accelerator, str) else None
                ),
                session=colab_session_name(project, key, state_root, config_home),
            )
        return 0
    if options["global"]:
        raise UsageError("--global is valid only with --use")

    (
        backend,
        accelerator,
        accelerator_set,
        ssh_host,
        checkpoint,
        workspace_id,
    ) = resolve_preferences(project, options, config_home, key)
    runner, image, devices = resolve_runner_preferences(
        options, project, config_home, key
    )
    if options["host"] is not None and backend != "host-ssh":
        raise UsageError("--host is valid only with the ssh backend")
    if accelerator_set and not ACCELERATOR.fullmatch(accelerator or ""):
        raise UsageError(
            "accelerator names may contain only letters, numbers, dot, dash, and underscore"
        )
    if accelerator and backend not in GPU_BACKENDS:
        raise UsageError(f"backend {backend!r} does not support accelerator requests")
    persistence_mode = validate_persistence(backend, checkpoint)
    oci_runtimes = validate_backend_oci_selection(
        backend=backend, runner=runner, devices=devices, accelerator=accelerator
    )
    managed_checkpoint = checkpoint and persistence_mode == "checkpoint"
    if action == "environment" and backend not in {"local", "colab-notebook"}:
        raise UsageError(
            f"backend {backend!r} does not yet provide an execution-environment profile"
        )
    if options["checkpoint"] is not None and action not in {None, "collect", "start"}:
        raise UsageError(
            "--persist/--no-persist is valid only with --use, --start, "
            "a project target, or --collect"
        )
    if (
        options["image"] is not None
        or options["native_runner"]
        or options["devices_set"]
    ) and action not in {None, "collect", "start"}:
        raise UsageError(
            "runner selection is valid only with --use, --start, a project target, "
            "or --collect"
        )
    if retry_seconds is not None and backend not in CAPACITY_RETRY_BACKENDS:
        raise UsageError(
            f"backend {backend!r} does not classify retryable allocation capacity"
        )
    if retry_seconds is not None and action is None and not positional:
        raise UsageError("--retry-for requires --start, a project target, or --collect")
    if action == "help" or (action is None and not positional):
        if positional:
            raise UsageError("--help does not accept arguments")
        print(help_text(project, backend, ssh_host), end="")
        return 0
    if backend == "host-ssh" and ssh_host is None:
        raise UsageError("the ssh backend requires --host HOST")

    if action is None:
        remote_target, assignments = positional[0], positional[1:]
        remote_collect_dir = None
        engine_target = "dispatch"
    elif action == "collect":
        if len(positional) < 2:
            raise UsageError("--collect requires a directory and project target")
        remote_collect_dir = collect_directory(positional[0])
        remote_target, assignments = positional[1], positional[2:]
        engine_target = "collect"
    else:
        if positional:
            raise UsageError(f"--{action} does not accept positional arguments")
        remote_target = None
        remote_collect_dir = None
        assignments = []
        engine_target = action

    validate_assignments(assignments)
    if remote_target is not None and (not remote_target or "\n" in remote_target):
        raise UsageError("project targets must be non-empty and contain no newline")
    if engine_target in {"dispatch", "collect"}:
        if not (project / "Makefile").is_file():
            raise UsageError(f"project Makefile was not found: {project / 'Makefile'}")

    if (
        options["accelerator_set"]
        and options["backend"] is None
        and engine_target in {"dispatch", "collect", "start", "environment"}
    ):
        persist_invocation_accelerator(
            project=project,
            config_home=config_home,
            key=key,
            accelerator=accelerator,
        )
    if (
        options["checkpoint"] is not None
        and engine_target in {"dispatch", "collect", "start"}
    ):
        persist_invocation_checkpoint(
            project=project,
            config_home=config_home,
            key=key,
            backend=backend,
            workspace_id=workspace_id,
            enabled=checkpoint,
            mode=persistence_mode,
        )
    if (
        (options["image"] is not None or options["native_runner"] or options["devices_set"])
        and options["backend"] is None
        and engine_target in {"dispatch", "collect", "start"}
    ):
        persist_invocation_runner(
            project=project,
            config_home=config_home,
            key=key,
            runner=runner,
            image=image,
            devices=devices,
        )
    state_root = state_home / "projects" / key
    colab_session = (
        colab_session_name(project, key, state_root, config_home)
        if backend == "colab-notebook"
        else None
    )
    if checkpoint and engine_target in {"dispatch", "collect", "start"}:
        if persistence_mode == "native":
            print(
                f"[cloudmake] persistence=native backend={backend} "
                "checkpoint-transfer=no",
                flush=True,
            )
        else:
            print(
                f"[cloudmake] persistence=checkpoint backend={backend} "
                f"workspace={workspace_id}",
                flush=True,
            )
    if managed_checkpoint:
        update_workspace_record(
            state_home=state_home,
            workspace_id=workspace_id,
            project=project,
            backend=backend,
            accelerator=accelerator,
            session=colab_session,
        )
    if engine_target not in {"dispatch", "collect"}:
        operation_allocation_path = (
            state_root / "operations" / f".{uuid.uuid4().hex}.allocation.json"
            if backend == "colab-notebook"
            else None
        )
        operation_state = (
            state_root / "operations" / f"{engine_target}.json"
            if backend == "colab-notebook"
            else None
        )
        if operation_state is not None:
            operation_state.unlink(missing_ok=True)
        exit_code = engine_command(
            project=project,
            backend=backend,
            accelerator=accelerator,
            accelerator_set=accelerator_set,
            ssh_host=ssh_host,
            jobs=options["jobs"],
            verbose=options["verbose"],
            state_home=state_home,
            cache_home=cache_home,
            key=key,
            workspace_id=workspace_id,
            target=engine_target,
            assignments=assignments,
            retry_seconds=retry_seconds,
            allocation_result=operation_allocation_path,
            remote_target=remote_target,
            remote_collect_dir=remote_collect_dir,
            checkpoint=managed_checkpoint,
            colab_session=colab_session,
            operation_state=operation_state,
            runner=runner,
            image=image,
            devices=devices,
            oci_runtimes=oci_runtimes,
        )
        if operation_allocation_path is not None:
            receipt = allocation_receipt(operation_allocation_path)
            exit_code = allocation_exit_code(receipt, exit_code)
            operation_allocation_path.unlink(missing_ok=True)
        lifecycle = (
            load_json(operation_state)
            if operation_state is not None and operation_state.is_file()
            else {}
        )
        if (
            exit_code != 0
            and lifecycle.get("failure_code")
            in {"readiness_deadline_exceeded", "readiness_deadline_cleanup_failed"}
        ):
            exit_code = 75
        if managed_checkpoint:
            update_workspace_record(
                state_home=state_home,
                workspace_id=workspace_id,
                project=project,
                backend=backend,
                accelerator=accelerator,
                session=colab_session,
                receipts=checkpoint_receipts(state_root, "operation"),
            )
        if (
            exit_code == 0
            and engine_target == "start"
            and BACKENDS[backend][0] == "yes"
            and backend != "host-ssh"
        ):
            print(
                "[cloudmake] subsequent targets reuse this resource until "
                "cloudmake --stop."
            )
        return exit_code

    run_id = uuid.uuid4().hex
    manifest_before = source_manifest_snapshot(state_root, backend)
    oci_before = oci_receipt_snapshot(state_root) if runner == "oci" else {}
    runs = state_root / "runs"
    allocation_path = (
        runs / f".{run_id}.allocation.json"
        if backend == "colab-notebook"
        else None
    )
    if allocation_path is not None:
        allocation_path.unlink(missing_ok=True)

    record_path = runs / f"{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}-{run_id}.json"
    record: dict[str, Any] = {
        "schema": 1,
        "run_id": run_id,
        "cloudmake_version": VERSION,
        "project": os.fspath(project),
        "project_key": key,
        "backend": backend,
        "operation": "collect" if engine_target == "collect" else "execute",
        "target": remote_target,
        "assignments": assignment_receipts(assignments),
        "collect_directory": remote_collect_dir,
        "started_at": utc_timestamp(),
        "status": "running",
        "checkpoint": {"enabled": managed_checkpoint},
        "persistent_workspace": {
            "enabled": checkpoint,
            "mode": persistence_mode if checkpoint else "disabled",
            "workspace_id": workspace_id if managed_checkpoint else None,
        },
        "runner": {
            "kind": runner,
            "image": image if runner == "oci" else None,
            "devices": devices if runner == "oci" else [],
            "runtime_candidates": oci_runtimes if runner == "oci" else [],
        },
    }
    if ssh_host is not None:
        record["host"] = ssh_host
    if retry_seconds is not None:
        record["allocation"] = {"attempts": 0, "outcome": "not-attempted"}
    atomic_json(record_path, record)
    operation_state = state_root / "operations" / f"{run_id}.json"
    try:
        if backend == "local":
            if runner == "native":
                print_local_execution_context(accelerator, accelerator_set)
                exit_code = local_make_command(
                    project=project,
                    target=remote_target,
                    assignments=assignments,
                    jobs=options["jobs"],
                    verbose=options["verbose"],
                )
                runner_receipt: dict[str, Any] = {}
            else:
                assert image is not None
                exit_code, runner_receipt = local_oci_command(
                    project=project,
                    image=image,
                    devices=devices,
                    oci_runtimes=oci_runtimes,
                    target=remote_target,
                    assignments=assignments,
                    jobs=options["jobs"],
                    state_root=state_root,
                    cache_home=cache_home,
                    run_id=run_id,
                    verbose=options["verbose"],
                )
                record["runner"].update(
                    {
                        name: runner_receipt[name]
                        for name in ("runtime", "digest", "image_inspection")
                        if name in runner_receipt
                    }
                )
            if exit_code:
                if runner == "native" or runner_receipt.get("status") == "target-failed":
                    print(
                        f"[cloudmake] target {remote_target!r} failed with exit status "
                        f"{exit_code}",
                        file=sys.stderr,
                    )
            if exit_code == 0 and engine_target == "collect":
                exit_code = collect_local_artifacts(
                    project=project,
                    directory=remote_collect_dir,
                    state_root=state_root,
                    run_id=run_id,
                    verbose=options["verbose"],
                )
        else:
            exit_code = engine_command(
                project=project,
                backend=backend,
                accelerator=accelerator,
                accelerator_set=accelerator_set,
                ssh_host=ssh_host,
                jobs=options["jobs"],
                verbose=options["verbose"],
                state_home=state_home,
                cache_home=cache_home,
                key=key,
                workspace_id=workspace_id,
                target=engine_target,
                assignments=assignments,
                retry_seconds=retry_seconds,
                allocation_result=allocation_path,
                remote_target=remote_target,
                remote_collect_dir=remote_collect_dir,
                run_id=run_id,
                checkpoint=managed_checkpoint,
                colab_session=colab_session,
                operation_state=operation_state,
                runner=runner,
                image=image,
                devices=devices,
                oci_runtimes=oci_runtimes,
            )
    except BaseException:
        if allocation_path is not None:
            receipt = allocation_receipt(allocation_path)
            if receipt is not None:
                record["allocation"] = receipt
            allocation_path.unlink(missing_ok=True)
        if managed_checkpoint:
            record["checkpoint"]["operations"] = checkpoint_receipts(
                state_root, run_id
            )
        record.update(status="interrupted", finished_at=utc_timestamp())
        atomic_json(record_path, record)
        atomic_json(runs / "latest.json", record)
        raise

    if allocation_path is not None:
        receipt = allocation_receipt(allocation_path)
        if receipt is not None:
            record["allocation"] = receipt
        exit_code = allocation_exit_code(receipt, exit_code)
        allocation_path.unlink(missing_ok=True)

    if managed_checkpoint:
        record["checkpoint"]["operations"] = checkpoint_receipts(state_root, run_id)
        record["persistent_workspace"]["operations"] = record["checkpoint"]["operations"]
        update_workspace_record(
            state_home=state_home,
            workspace_id=workspace_id,
            project=project,
            backend=backend,
            accelerator=accelerator,
            session=colab_session,
            receipts=record["checkpoint"]["operations"],
        )
    lifecycle = load_json(operation_state) if operation_state.is_file() else {}
    if (
        exit_code != 0
        and lifecycle.get("failure_code")
        in {"readiness_deadline_exceeded", "readiness_deadline_cleanup_failed"}
    ):
        exit_code = 75
    if backend == "local":
        resource_id, source = os.fspath(project), {"mode": "local-working-tree"}
    else:
        resource_id, source = newest_source_manifest(state_root, backend, manifest_before)
    record.update(
        status=(
            "succeeded"
            if exit_code == 0
            else "interrupted" if exit_code == 130 else "failed"
        ),
        exit_code=exit_code,
        finished_at=utc_timestamp(),
        resource_id=resource_id,
        source=source,
    )
    if lifecycle:
        record["lifecycle"] = lifecycle
        for field in (
            "phase",
            "provider_state",
            "runtime_state",
            "session_created",
            "target_submission",
            "preparation_state",
            "retry_safe",
            "failure_code",
        ):
            if field in lifecycle:
                record[field] = lifecycle[field]
    if runner == "oci":
        runner_receipt = newest_oci_receipt(state_root, oci_before)
        record["runner"].update(
            {
                name: runner_receipt[name]
                for name in ("runtime", "digest", "image_inspection", "status", "error")
                if name in runner_receipt
            }
        )
    if engine_target == "collect" and exit_code == 0:
        record["artifacts"] = artifact_receipt(project / "artifacts")
    atomic_json(record_path, record)
    atomic_json(runs / "latest.json", record)
    print(f"[cloudmake] run={run_id} provenance={record_path}")
    return exit_code


def main() -> int:
    try:
        return run(sys.argv[1:])
    except UsageError as error:
        print(f"cloudmake: {error}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        print("cloudmake: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
